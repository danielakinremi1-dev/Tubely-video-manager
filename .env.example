# Local development defaults: works out of the box with `docker compose up -d`.
# Copy to .env (`cp .env.example .env`); .env is git-ignored.

DB_PATH="./tubely.db"
JWT_SECRET="change-me-to-a-long-random-string"
PLATFORM="dev"
FILEPATH_ROOT="./app"
PORT="8091"

# --- Media storage (local S3 emulator from docker-compose.yml) ---
S3_BUCKET="tubely-local"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9090"
S3_FORCE_PATH_STYLE="true"
MEDIA_BASE_URL="http://localhost:9090/tubely-local"

# The emulator ignores credentials, but the AWS SDK still signs requests, so
# it needs placeholder values. These are not real keys.
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# --- Using real AWS instead ---
# The easy path is the Terraform demo stack: `make aws-up` writes .env.aws and
# `make dev-aws` runs the server with it (ENV_FILE=.env.aws). See
# docs/AWS_DEMO.md. Done by hand, it looks like this:
# S3_BUCKET / S3_REGION: your bucket and its region
# S3_ENDPOINT / S3_FORCE_PATH_STYLE: remove both
# MEDIA_BASE_URL: https://<your-cloudfront-domain>
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: remove both and let the SDK use
#   ~/.aws/credentials (`aws configure`) or AWS_PROFILE
# S3_ROLE_ARN: optional; a role to assume for temporary credentials

# ENV_FILE (set in the shell, not here) picks a different settings file,
# e.g. ENV_FILE=.env.aws. Only that one file is read.
